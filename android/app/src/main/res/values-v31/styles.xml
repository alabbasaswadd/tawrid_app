<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+): mandatory SplashScreen API.
     Background matches the Flutter splash page so there is no visible
     transition between the system splash and the in-app splash. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/brand_green</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/brand_green</item>
    </style>
</resources>
